NODE_ENV=development
PORT=5001
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=postgres://postgres:change-me@localhost:5432/agrisathi
DB_SSL=false

# Must match the existing authentication service's JWT signing secret and cookie.
JWT_SECRET=
AUTH_COOKIE_NAME=accessToken
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_COOKIE_SAME_SITE=lax
OTP_HASH_SECRET=
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_TEST_OTP_ENABLED=false
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_MOBILE=
ADMIN_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
# SMS Horizon uses its documented form fields and a Bearer token.
SMS_PROVIDER=smshorizon
SMSHORIZON_API_KEY=
SMSHORIZON_USERNAME=
SMSHORIZON_SENDER_ID=
SMSHORIZON_DLT_TEMPLATE_ID=
# Must match the approved DLT template exactly; {code} is replaced with the OTP.
SMSHORIZON_OTP_MESSAGE_TEMPLATE=
SMSHORIZON_TYPE=txt

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_DAILY_LIMIT=40

# Crop images are sent to the selected external provider only after farmer consent.
CROP_DOCTOR_PROVIDER=gemini
HUGGINGFACE_API_TOKEN=
# Optional hosted image classifier; availability and free-tier quotas depend on Hugging Face.
HUGGINGFACE_CROP_MODEL=surgeonwz/plant-village

# Add an authorized Data.gov.in source in the admin market catalog before syncing prices.
MARKET_DATA_API_KEY=

GOOGLE_SPEECH_API_KEY=
GOOGLE_TTS_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=agrisathi/crop-diagnoses
AGRI_SHORTS_MAX_VIDEO_BYTES=104857600
FRONTEND_PUBLIC_URL=http://localhost:5173

# Marketplace orders support cash-on-delivery only when explicitly enabled.
# Online payments remain unavailable until a verified gateway integration is configured.
MARKETPLACE_COD_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MARKETPLACE_PRODUCT_IMAGE_MAX_BYTES=5242880
LIVESTOCK_IMAGE_MAX_BYTES=5242880
LIVESTOCK_VIDEO_MAX_BYTES=31457280

# Configure only if an existing consultation service is available.
EXPERT_CONSULTATION_API_URL=
EXPERT_CONSULTATION_API_TOKEN=
CONSULTATION_ALLOW_IMAGE=false

# Public contact and newsletter notification email
SUPPORT_EMAIL=
NEWSLETTER_PUBLIC_URL=http://localhost:5173

# No official-alert feed is assumed. Configure a trusted server-side provider URL if available.
WEATHER_ALERTS_URL=

# Optional. Bigha varies by region; both values must identify the local convention.
BIGHA_REGION=
BIGHA_SQUARE_METERS=
